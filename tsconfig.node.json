{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node", "vite/client"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/backend/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/api/numeric-input.ts",
    "src/renderer/src/api/response-scope.ts",
    "src/renderer/src/api/operation-correction-outcome.ts",
    "src/renderer/src/api/operation-deletion-outcome.ts",
    "src/renderer/src/api/tariff-maintenance-outcome.ts",
    "src/renderer/src/api/weight-change-outcome.ts",
    "doc/p00/contratti.ts",
    "doc/p00/scenari.mts",
    "tests/**/*.ts",
    "src/renderer/src/api/application-request.ts",
    "src/renderer/src/api/draft-guard.ts",
    "src/renderer/src/api/write-attempt.ts",
    "src/renderer/src/api/operation-creation-outcome.ts",
    "src/renderer/src/api/single-flight.ts"
  ]
}
